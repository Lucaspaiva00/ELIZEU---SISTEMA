generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS GERAIS
// =====================================================

enum PerfilUsuario {
  ADMIN
  GERENTE
  VENDEDOR
  FINANCEIRO
  ESTOQUE
  FISCAL
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum UnidadeMedida {
  UN
  KG
  G
  L
  ML
  M
  CM
  CX
  PC
  PAR
  H
  DIA
  M2
  M3
}

enum TipoItemComercial {
  PRODUTO
  SERVICO
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  SIMPLES_NACIONAL_EXCESSO
  REGIME_NORMAL
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum StatusNotaFiscal {
  PENDENTE_CONFIGURACAO
  PRONTA_TRANSMISSAO
  TRANSMITINDO
  AUTORIZADA
  REJEITADA
  ERRO
  CANCELADA
}

// =====================================================
// ENUMS COMERCIAIS
// =====================================================

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
  CANCELADO
  VENCIDO
}

enum StatusVenda {
  CONFIRMADA
  FATURADA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  CHEQUE
  CREDITO_LOJA
  OUTRO
}

enum PeriodicidadeParcela {
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  PERSONALIZADA
}

// =====================================================
// ENUMS FINANCEIROS
// =====================================================

enum TipoContaFinanceira {
  CAIXA
  CONTA_CORRENTE
  POUPANCA
  CARTEIRA_DIGITAL
  OUTRA
}

enum NaturezaFinanceira {
  RECEITA
  DESPESA
  AMBAS
}

enum StatusTitulo {
  PENDENTE
  PARCIAL
  PAGO
  ATRASADO
  CANCELADO
}

enum TipoMovimentacaoFinanceira {
  ENTRADA
  SAIDA
}

enum OrigemMovimentacaoFinanceira {
  CONTA_RECEBER
  CONTA_PAGAR
  VENDA
  LANCAMENTO_MANUAL
  TRANSFERENCIA
  ESTORNO
  AJUSTE
}

// =====================================================
// ENUMS DE ESTOQUE
// =====================================================

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
  DEVOLUCAO
  CANCELAMENTO_VENDA
}

enum OrigemMovimentacaoEstoque {
  VENDA
  COMPRA
  AJUSTE_MANUAL
  DEVOLUCAO
  CANCELAMENTO
  INVENTARIO
}

// =====================================================
// EMPRESA E USUARIOS
// =====================================================

model Empresa {
  id Int @id @default(autoincrement())

  razaoSocial  String
  nomeFantasia String?
  cnpj         String  @unique

  inscricaoEstadual String?
  telefone          String?
  celular           String?
  email             String?

  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  logo        String?
  ativa       Boolean @default(true)

  usuarios                 Usuario[]
  categorias               CategoriaProduto[]
  produtos                 Produto[]
  categoriasServico        CategoriaServico[]
  servicos                 Servico[]
  clientes                 Cliente[]
  orcamentos               Orcamento[]
  tabelasPreco             TabelaPreco[]
  vendas                   Venda[]
  contasFinanceiras        ContaFinanceira[]
  categoriasFinanceiras    CategoriaFinanceira[]
  centrosCusto             CentroCusto[]
  contasReceber            ContaReceber[]
  contasPagar              ContaPagar[]
  movimentacoesFinanceiras MovimentacaoFinanceira[]
  movimentacoesEstoque     MovimentacaoEstoque[]
  configuracaoFiscal       ConfiguracaoFiscal?
  certificadoDigital       CertificadoDigital?
  notasFiscais              NotaFiscal[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model ConfiguracaoFiscal {
  id Int @id @default(autoincrement())

  empresaId Int     @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  regimeTributario       RegimeTributario?
  crt                     Int?
  inscricaoMunicipal      String?
  cnaePrincipal           String?
  codigoMunicipio         String?
  ambiente                AmbienteFiscal @default(HOMOLOGACAO)
  serieNfe                Int            @default(1)
  proximoNumeroNfe        Int            @default(1)
  cfopPadrao              String?
  naturezaOperacao        String?
  emailFiscal             String?
  informacoesComplementares String?      @db.Text
  ativo                   Boolean        @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([empresaId, ambiente])
}

model CertificadoDigital {
  id Int @id @default(autoincrement())

  empresaId Int     @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nomeArquivo           String
  conteudoCriptografado String   @db.Text
  iv                    String
  authTag               String
  validade              DateTime?
  ativo                 Boolean  @default(true)
  enviadoEm             DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@index([empresaId, ativo])
}

model Usuario {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome     String
  email    String        @unique
  senha    String
  telefone String?
  perfil   PerfilUsuario @default(VENDEDOR)
  ativo    Boolean       @default(true)

  ultimoLogin DateTime?

  orcamentosCriados   Orcamento[]              @relation("OrcamentoCriadoPor")
  orcamentosAprovados Orcamento[]              @relation("OrcamentoAprovadoPor")
  vendasCriadas       Venda[]                  @relation("VendaCriadaPor")
  movimentacoes       MovimentacaoFinanceira[] @relation("MovimentacaoCriadaPor")
  movimentosEstoque   MovimentacaoEstoque[]    @relation("MovimentoEstoqueResponsavel")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([empresaId])
}

// =====================================================
// PRODUTOS, VARIACOES E TABELAS DE PRECO
// =====================================================

model CategoriaProduto {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome      String
  descricao String?
  ativo     Boolean @default(true)

  produtos Produto[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Produto {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  categoriaId Int
  categoria   CategoriaProduto @relation(fields: [categoriaId], references: [id])

  codigo    String
  nome      String
  descricao String?
  marca     String?

  unidadeMedida          UnidadeMedida @default(UN)
  controlaEstoque        Boolean       @default(true)
  permiteVendaSemEstoque Boolean       @default(false)

  ncm              String?
  cfopPadrao       String?
  origemMercadoria String?
  ativo            Boolean @default(true)

  // Composição do produto/padrão para formação do custo base.
  // Ex.: poste, caixa, cabo, disjuntor etc.
  composicao        Json?
  custoComposicao   Decimal @default(0) @db.Decimal(12, 2)
  margemLucroPadrao Decimal @default(0) @db.Decimal(7, 3)

  variacoes VariacaoProduto[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, categoriaId])
}

model VariacaoProduto {
  id Int @id @default(autoincrement())

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  sku          String  @unique
  codigoBarras String?
  descricao    String?
  saida        String?
  tamanho      String?

  imagemPrincipal    String?
  gtin               String?
  localizacaoEstoque String?
  peso               Decimal? @db.Decimal(10, 3)

  precoCusto Decimal @db.Decimal(12, 2)
  precoVenda Decimal @db.Decimal(12, 2)

  estoqueAtual  Decimal @default(0) @db.Decimal(12, 3)
  estoqueMinimo Decimal @default(0) @db.Decimal(12, 3)
  ativo         Boolean @default(true)

  itensOrcamento       ItemOrcamento[]
  itensVenda           ItemVenda[]
  itensTabelaPreco     ItemTabelaPreco[]
  movimentacoesEstoque MovimentacaoEstoque[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([produtoId])
  @@index([codigoBarras])
}

model CategoriaServico {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome      String
  descricao String?
  ativo     Boolean @default(true)

  servicos Servico[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Servico {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  categoriaId Int
  categoria   CategoriaServico @relation(fields: [categoriaId], references: [id])

  codigo        String
  nome          String
  descricao     String?
  unidadeMedida UnidadeMedida @default(UN)
  ativo          Boolean @default(true)

  variacoes VariacaoServico[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, categoriaId])
}

model VariacaoServico {
  id Int @id @default(autoincrement())

  servicoId Int
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  codigo       String @unique
  descricao    String?
  precoCusto   Decimal @default(0) @db.Decimal(12, 2)
  precoVenda   Decimal @db.Decimal(12, 2)
  ativo        Boolean @default(true)

  itensOrcamento   ItemOrcamento[]
  itensVenda       ItemVenda[]
  itensTabelaPreco ItemTabelaPrecoServico[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([servicoId])
}

model TabelaPreco {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome             String
  descricao        String?
  percentualAjuste Decimal?  @db.Decimal(7, 3)
  dataInicio       DateTime?
  dataFim          DateTime?
  padrao           Boolean   @default(false)
  ativa            Boolean   @default(true)

  itens      ItemTabelaPreco[]
  itensServico ItemTabelaPrecoServico[]
  orcamentos Orcamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([empresaId, ativa])
}

model ItemTabelaPreco {
  id Int @id @default(autoincrement())

  tabelaPrecoId     Int
  variacaoProdutoId Int

  tabelaPreco     TabelaPreco     @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  variacaoProduto VariacaoProduto @relation(fields: [variacaoProdutoId], references: [id], onDelete: Cascade)

  preco Decimal @db.Decimal(12, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tabelaPrecoId, variacaoProdutoId])
  @@index([variacaoProdutoId])
}

model ItemTabelaPrecoServico {
  id Int @id @default(autoincrement())

  tabelaPrecoId     Int
  variacaoServicoId Int

  tabelaPreco     TabelaPreco     @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  variacaoServico VariacaoServico @relation(fields: [variacaoServicoId], references: [id], onDelete: Cascade)

  preco Decimal @db.Decimal(12, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tabelaPrecoId, variacaoServicoId])
  @@index([variacaoServicoId])
}

// =====================================================
// CLIENTES
// =====================================================

model Cliente {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  tipoPessoa   TipoPessoa
  nome         String
  nomeFantasia String?
  cpfCnpj      String

  inscricaoEstadual String?
  telefone          String?
  celular           String?
  email             String?

  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  limiteCredito        Decimal? @db.Decimal(12, 2)
  prazoPagamentoPadrao Int?
  observacoes          String?
  ativo                Boolean  @default(true)

  // Integração SacMais
  sacmaisId             String?
  origemCadastro        String?  @default("ERP")
  sincronizadoSacMaisEm DateTime?

  orcamentos    Orcamento[]
  vendas        Venda[]
  contasReceber ContaReceber[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, cpfCnpj])
  @@unique([empresaId, sacmaisId])
  @@index([empresaId, nome])
  @@index([empresaId, sacmaisId])
}

// =====================================================
// ORCAMENTOS E APROVACAO
// =====================================================

model Orcamento {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  numero    Int
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  tabelaPrecoId Int?
  tabelaPreco   TabelaPreco? @relation(fields: [tabelaPrecoId], references: [id], onDelete: SetNull)

  criadoPorId Int?
  criadoPor   Usuario? @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  aprovadoPorId Int?
  aprovadoPor   Usuario? @relation("OrcamentoAprovadoPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)

  status       StatusOrcamento @default(RASCUNHO)
  dataValidade DateTime?
  aprovadoEm   DateTime?
  rejeitadoEm  DateTime?
  canceladoEm  DateTime?
  motivoStatus String?

  formaPagamento             FormaPagamento?
  quantidadeParcelas         Int                  @default(1)
  periodicidadeParcelas      PeriodicidadeParcela @default(MENSAL)
  intervaloPersonalizadoDias Int?
  primeiroVencimento         DateTime?

  itens ItemOrcamento[]
  venda Venda?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  desconto       Decimal @default(0) @db.Decimal(12, 2)
  frete          Decimal @default(0) @db.Decimal(12, 2)
  outrasDespesas Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  // Custos internos: não aparecem na proposta/PDF enviado ao cliente.
  custosInternos    Json?
  custoItensTotal   Decimal @default(0) @db.Decimal(12, 2)
  custoInternoTotal Decimal @default(0) @db.Decimal(12, 2)
  lucroEstimado     Decimal @default(0) @db.Decimal(12, 2)

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@index([clienteId])
}

model ItemOrcamento {
  id Int @id @default(autoincrement())

  orcamentoId       Int
  tipo               TipoItemComercial @default(PRODUTO)
  variacaoProdutoId  Int?
  variacaoServicoId  Int?

  orcamento       Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  variacaoProduto VariacaoProduto? @relation(fields: [variacaoProdutoId], references: [id])
  variacaoServico VariacaoServico? @relation(fields: [variacaoServicoId], references: [id])

  quantidade    Decimal @db.Decimal(12, 3)
  valorUnitario Decimal @db.Decimal(12, 2)
  desconto      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  custoUnitario Decimal @default(0) @db.Decimal(12, 2)

  criadoEm DateTime @default(now())

  @@index([orcamentoId])
  @@index([variacaoProdutoId])
  @@index([variacaoServicoId])
}

// =====================================================
// VENDAS GERADAS A PARTIR DE ORCAMENTOS
// =====================================================

model Venda {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  numero Int

  orcamentoId Int?       @unique
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  criadoPorId Int?
  criadoPor   Usuario? @relation("VendaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  status StatusVenda @default(CONFIRMADA)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  desconto       Decimal @default(0) @db.Decimal(12, 2)
  frete          Decimal @default(0) @db.Decimal(12, 2)
  outrasDespesas Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  // Snapshot dos custos internos do orçamento para cálculo histórico do lucro.
  custosInternos    Json?
  custoItensTotal   Decimal @default(0) @db.Decimal(12, 2)
  custoInternoTotal Decimal @default(0) @db.Decimal(12, 2)
  lucroEstimado     Decimal @default(0) @db.Decimal(12, 2)

  formaPagamento        FormaPagamento
  quantidadeParcelas    Int                  @default(1)
  periodicidadeParcelas PeriodicidadeParcela @default(MENSAL)
  primeiroVencimento    DateTime

  dataVenda          DateTime  @default(now())
  canceladaEm        DateTime?
  motivoCancelamento String?
  observacoes        String?

  itens                ItemVenda[]
  contasReceber        ContaReceber[]
  contasPagar          ContaPagar[]
  movimentacoesEstoque MovimentacaoEstoque[]
  notaFiscal           NotaFiscal?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, status, dataVenda])
  @@index([clienteId])
}

model ItemVenda {
  id Int @id @default(autoincrement())

  vendaId           Int
  tipo               TipoItemComercial @default(PRODUTO)
  variacaoProdutoId  Int?
  variacaoServicoId  Int?

  venda           Venda           @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  variacaoProduto VariacaoProduto? @relation(fields: [variacaoProdutoId], references: [id])
  variacaoServico VariacaoServico? @relation(fields: [variacaoServicoId], references: [id])

  // Snapshot comercial para preservar o historico da venda.
  codigoProduto String?
  sku           String
  descricao     String
  quantidade    Decimal @db.Decimal(12, 3)
  valorUnitario Decimal @db.Decimal(12, 2)
  desconto      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  custoUnitario Decimal @default(0) @db.Decimal(12, 2)

  movimentosEstoque MovimentacaoEstoque[]

  criadoEm DateTime @default(now())

  @@index([vendaId])
  @@index([variacaoProdutoId])
  @@index([variacaoServicoId])
}


// =====================================================
// NOTAS FISCAIS - NF-e
// =====================================================

model NotaFiscal {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  vendaId Int   @unique
  venda   Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  status   StatusNotaFiscal @default(PENDENTE_CONFIGURACAO)
  ambiente AmbienteFiscal

  modelo Int @default(55)
  serie  Int
  numero Int

  chaveAcesso String?
  protocolo   String?

  naturezaOperacao String?
  dadosEmissao      Json?

  xmlEnvio   String? @db.Text
  xmlRetorno String? @db.Text
  motivoStatus String? @db.Text

  preparadaEm  DateTime @default(now())
  transmitidaEm DateTime?
  autorizadaEm DateTime?
  canceladaEm  DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, serie, numero])
  @@index([empresaId, status])
  @@index([vendaId])
}

// =====================================================
// CADASTROS FINANCEIROS
// =====================================================

model ContaFinanceira {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome             String
  tipo             TipoContaFinanceira @default(CAIXA)
  banco            String?
  agencia          String?
  numeroConta      String?
  saldoInicial     Decimal             @default(0) @db.Decimal(14, 2)
  dataSaldoInicial DateTime            @default(now())
  padrao           Boolean             @default(false)
  ativa            Boolean             @default(true)

  movimentacoes MovimentacaoFinanceira[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([empresaId, ativa])
}

model CategoriaFinanceira {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome      String
  natureza  NaturezaFinanceira
  descricao String?
  ativa     Boolean            @default(true)

  categoriaPaiId Int?
  categoriaPai   CategoriaFinanceira?  @relation("CategoriaFinanceiraHierarquia", fields: [categoriaPaiId], references: [id], onDelete: SetNull)
  subcategorias  CategoriaFinanceira[] @relation("CategoriaFinanceiraHierarquia")

  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  movimentacoes MovimentacaoFinanceira[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([empresaId, natureza])
}

model CentroCusto {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  codigo    String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]
  movimentacoes MovimentacaoFinanceira[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, ativo])
}

// =====================================================
// CONTAS A RECEBER E CONTAS A PAGAR
// =====================================================

model ContaReceber {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  categoriaFinanceiraId Int?
  categoriaFinanceira   CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id], onDelete: SetNull)

  centroCustoId Int?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  descricao       String
  numeroDocumento String?
  parcelaNumero   Int     @default(1)
  totalParcelas   Int     @default(1)

  valorOriginal Decimal @db.Decimal(14, 2)
  valorDesconto Decimal @default(0) @db.Decimal(14, 2)
  valorJuros    Decimal @default(0) @db.Decimal(14, 2)
  valorMulta    Decimal @default(0) @db.Decimal(14, 2)
  valorRecebido Decimal @default(0) @db.Decimal(14, 2)

  dataCompetencia DateTime
  dataEmissao     DateTime  @default(now())
  dataVencimento  DateTime
  dataRecebimento DateTime?

  formaPagamento FormaPagamento?
  status         StatusTitulo    @default(PENDENTE)
  observacoes    String?

  movimentacoes MovimentacaoFinanceira[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([vendaId, parcelaNumero])
  @@index([empresaId, status, dataVencimento])
  @@index([clienteId])
}

model ContaPagar {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  // Identifica a linha de custo interno que originou o título.
  // Em conjunto com vendaId impede geração duplicada no faturamento.
  custoInternoIndice Int?

  categoriaFinanceiraId Int?
  categoriaFinanceira   CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id], onDelete: SetNull)

  centroCustoId Int?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  fornecedorNome      String?
  fornecedorDocumento String?
  descricao           String
  numeroDocumento     String?
  parcelaNumero       Int     @default(1)
  totalParcelas       Int     @default(1)

  valorOriginal Decimal @db.Decimal(14, 2)
  valorDesconto Decimal @default(0) @db.Decimal(14, 2)
  valorJuros    Decimal @default(0) @db.Decimal(14, 2)
  valorMulta    Decimal @default(0) @db.Decimal(14, 2)
  valorPago     Decimal @default(0) @db.Decimal(14, 2)

  dataCompetencia DateTime
  dataEmissao     DateTime  @default(now())
  dataVencimento  DateTime
  dataPagamento   DateTime?

  formaPagamento   FormaPagamento?
  status           StatusTitulo    @default(PENDENTE)
  recorrente       Boolean         @default(false)
  recorrenciaGrupo String?
  observacoes      String?

  movimentacoes MovimentacaoFinanceira[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([vendaId, custoInternoIndice])
  @@index([empresaId, status, dataVencimento])
  @@index([vendaId])
  @@index([recorrenciaGrupo])
}

// =====================================================
// MOVIMENTACOES DE CAIXA E BANCOS
// =====================================================

model MovimentacaoFinanceira {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  contaFinanceiraId Int
  contaFinanceira   ContaFinanceira @relation(fields: [contaFinanceiraId], references: [id])

  categoriaFinanceiraId Int?
  categoriaFinanceira   CategoriaFinanceira? @relation(fields: [categoriaFinanceiraId], references: [id], onDelete: SetNull)

  centroCustoId Int?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  contaReceberId Int?
  contaReceber   ContaReceber? @relation(fields: [contaReceberId], references: [id], onDelete: SetNull)

  contaPagarId Int?
  contaPagar   ContaPagar? @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)

  criadoPorId Int?
  criadoPor   Usuario? @relation("MovimentacaoCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  tipo   TipoMovimentacaoFinanceira
  origem OrigemMovimentacaoFinanceira

  descricao        String
  valor            Decimal         @db.Decimal(14, 2)
  dataMovimentacao DateTime
  dataCompetencia  DateTime?
  formaPagamento   FormaPagamento?
  documento        String?

  conciliada         Boolean   @default(false)
  conciliadaEm       DateTime?
  transferenciaGrupo String?
  estornada          Boolean   @default(false)
  estornadaEm        DateTime?
  observacoes        String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([empresaId, dataMovimentacao])
  @@index([contaFinanceiraId, dataMovimentacao])
  @@index([contaReceberId])
  @@index([contaPagarId])
  @@index([transferenciaGrupo])
}

// =====================================================
// MOVIMENTACOES E RASTREABILIDADE DO ESTOQUE
// =====================================================

model MovimentacaoEstoque {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  variacaoProdutoId Int
  variacaoProduto   VariacaoProduto @relation(fields: [variacaoProdutoId], references: [id])

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  itemVendaId Int?
  itemVenda   ItemVenda? @relation(fields: [itemVendaId], references: [id], onDelete: SetNull)

  responsavelId Int?
  responsavel   Usuario? @relation("MovimentoEstoqueResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  tipo   TipoMovimentacaoEstoque
  origem OrigemMovimentacaoEstoque

  quantidade       Decimal  @db.Decimal(12, 3)
  saldoAnterior    Decimal  @db.Decimal(12, 3)
  saldoPosterior   Decimal  @db.Decimal(12, 3)
  dataMovimentacao DateTime @default(now())
  observacoes      String?

  criadoEm DateTime @default(now())

  @@index([empresaId, dataMovimentacao])
  @@index([variacaoProdutoId, dataMovimentacao])
  @@index([vendaId])
}
